# PayPal sandbox app: developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
ANTHROPIC_API_KEY=
# Optional, defaults to claude-haiku-5-5
ANTHROPIC_MODEL=
# Any long random string; signs tool approvals so a client can't forge them (openssl rand -hex 32)
TOOL_APPROVAL_SECRET=
# Optional, defaults to claude-sonnet-5-5 (revenue recognition and dispute judgment)
ANTHROPIC_JUDGMENT_MODEL=

# Webhook id from the PayPal app (Webhooks section); verifies incoming webhook signatures
PAYPAL_WEBHOOK_ID=
