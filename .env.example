# PayPal sandbox app: developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
OPENAI_API_KEY=
# Optional, defaults to gpt-5.4-mini
OPENAI_MODEL=
# Any long random string; signs tool approvals so a client can't forge them (openssl rand -hex 32)
TOOL_APPROVAL_SECRET=
# Optional, defaults to gpt-5.5 (revenue recognition classification)
OPENAI_JUDGMENT_MODEL=
